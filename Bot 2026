        job.schedule_removal()
        
    if auto_trading_enabled:
        last_state = None
        # Передаємо чисту функцію без зайвих обгорток lambda з update параметрами
        job_queue.run_repeating(
            check_macd_and_trade, 
            interval=AUTO_TRADE_INTERVAL, 
            first=1, 
            name="st_auto_job", 
            data={"chat_id": update.effective_chat.id}
        )
        await update.message.reply_text("🚀 <b>Автотрейдинг за SuperTrend УВІМКНЕНО!</b>\nАналіз закриття свічок відбувається щохвилини (Час: Париж).", parse_mode="HTML")
