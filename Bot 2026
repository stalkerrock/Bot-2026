# --- 🎯 ТЕХНІЧНИЙ АНАЛІЗ (СУПЕРТРЕНД) ---
def get_supertrend_signal():
    try:
        # Беремо свіжі хвилинні свічки зі споту
        klines = client.get_klines(symbol=TRADE_SYMBOL, interval=TEST_INTERVAL, limit=100)
        df = pd.DataFrame(klines, columns=['time', 'open', 'high', 'low', 'close', 'volume', 'close_time', 'q_volume', 'trades', 'bba_low', 'bba_high', 'ignored'])
        df['high'] = df['high'].astype(float)
        df['low'] = df['low'].astype(float)
        df['close'] = df['close'].astype(float)
        
        # Розрахунок SuperTrend
        st = ta.supertrend(df['high'], df['low'], df['close'], length=SUPERTREND_PERIOD, multiplier=SUPERTREND_MULTIPLIER)
        dir_col = [col for col in st.columns if col.startswith("SUPERTd")][0]
        val_col = [col for col in st.columns if col.startswith("SUPERT_")][0]
        df = df.join(st)
        
        # Перевіряємо саме остаточно ЗАКРИТУ свічку (індекс -2)
        closed_candle = df.iloc[-2]
        prev_candle = df.iloc[-3]
        
        candle_st_state = "LONG" if closed_candle[dir_col] == 1 else "SHORT"
        prev_st_state = "LONG" if prev_candle[dir_col] == 1 else "SHORT"
        
        # Переведення часу свічки у часовий пояс Парижа
        utc_time = datetime.utcfromtimestamp(int(closed_candle['time']) / 1000).replace(tzinfo=pytz.utc)
        paris_time_str = utc_time.astimezone(PARIS_TZ).strftime('%H:%M:%S')
        
        action = None
        if prev_st_state == "SHORT" and candle_st_state == "LONG":
            action = "BUY"
        elif prev_st_state == "LONG" and candle_st_state == "SHORT":
            action = "SELL"
            
        return {
            "action": action, 
            "current_state": candle_st_state, 
            "current_price": df.iloc[-1]['close'],
            "line_value": closed_candle[val_col],
            "candle_time": paris_time_str
        }
    except Exception as e:
        logging.error(f"Помилка індикатора: {e}")
        return None

